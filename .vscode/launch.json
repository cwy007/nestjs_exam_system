{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "debug nest (user)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start:debug", "--", "exam"],
      "console": "integratedTerminal",
      "autoAttachChildProcesses": true,
      "restart": true,
      "sourceMaps": true,
      "outFiles": ["${workspaceFolder}/dist/**/*.js", "!**/node_modules/**"],
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
